FROM python:3.14-slim-trixie AS builder

# Install build tools and dev libraries
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
        ffmpeg default-mysql-client tesseract-ocr libtesseract-dev \
        libffi-dev libcairo2-dev pkg-config gcc curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt backend/

# Use uv for clean package installation (avoids stale pip layer metadata)
RUN pip install --no-cache-dir uv \
    && uv venv /opt/venv \
    && uv pip install --python /opt/venv/bin/python --no-cache -r backend/requirements.txt \
    && uv cache clean \
    && rm -rf /root/.cache/uv

# Runtime stage - minimal packages only
FROM python:3.14-slim-trixie

RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends ffmpeg tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r appgroup && useradd -r -g appgroup -d /app -s /sbin/nologin appuser

WORKDIR /app

# Copy venv from builder
COPY --from=builder /opt/venv /opt/venv

COPY backend/ /app/backend/
COPY run.py /app/run.py
COPY CHANGELOG.md LICENSE PRIVACY.md /app/

ENV PATH=/opt/venv/bin:$PATH
ENV VIRTUAL_ENV=/opt/venv

# Remove build-time Python packaging tools from the runtime layer; the app uses the
# copied virtualenv and does not need pip/setuptools vendor bundles at runtime.
RUN rm -rf /usr/local/lib/python*/site-packages/pip* \
    /usr/local/lib/python*/site-packages/setuptools* \
    /usr/local/lib/python*/site-packages/wheel*

# Create media directories writable by non-root user
RUN mkdir -p /media /app/backend/media && chown -R appuser:appgroup /app /media

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["sh", "-c", "uvicorn backend.app:app --host 0.0.0.0 --port 8000 --workers 2 2>&1 | tee /media/app.log"]
